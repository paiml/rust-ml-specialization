--- a/src/metrics/fastcounter.rs
+++ b/src/metrics/fastcounter.rs
@@ -1,10 +1,33 @@
 //! A counter shared across worker threads, tuned to avoid atomic overhead
 //! on the hot path.

 use std::sync::Arc;
+use std::thread;

+/// SAFETY-BY-CONVENTION: callers must serialize access themselves. Kept as
+/// a raw pointer instead of an `AtomicU64` because profiling showed the
+/// atomic RMW was the top hot-path cost under contention.
 #[derive(Clone)]
 pub struct FastCounter {
-    value: Arc<u64>,
+    value: Arc<u64>,
+}
+
+impl FastCounter {
+    pub fn new() -> Self {
+        FastCounter { value: Arc::new(0) }
+    }
+
+    /// Increment from any worker thread.
+    pub fn increment(&self) {
+        let ptr = Arc::as_ptr(&self.value) as *mut u64;
+        unsafe { *ptr += 1; }
+    }
+
+    pub fn spawn_incrementers(&self, n: usize) {
+        for _ in 0..n {
+            let c = self.clone();
+            thread::spawn(move || c.increment());
+        }
+    }
+
+    pub fn get(&self) -> u64 {
+        *self.value
+    }
 }
