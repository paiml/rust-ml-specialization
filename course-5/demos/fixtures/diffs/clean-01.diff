+    /// Number of free bytes remaining before the window must roll over.
+    ///
+    /// Uses `saturating_sub` so a window that is already full (or, by a
+    /// caller bug, reports more filled than capacity) never underflows.
+    pub fn free(&self) -> usize {
+        self.data.len().saturating_sub(self.len)
+    }
+
+    /// True once the window cannot accept another byte without evicting.
+    pub fn is_full(&self) -> bool {
+        self.free() == 0
+    }
+
+    /// Largest contiguous run of bytes we can hand back right now.
+    pub fn readable(&self) -> usize {
+        min(self.len, self.data.len())
+    }
