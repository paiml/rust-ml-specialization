+/// Applies a coupon to a price and reports the delta charged to the
+/// customer relative to the coupon's face value, for the receipt line.
+pub fn discount(price: i64, coupon: i64) -> i64 {
+    subtract(price, coupon)
+}
+
+pub fn coupon_variance(price: i64, coupon: i64) -> i64 {
+    let charged = discount(price, coupon);
+    let diff = subtract(coupon, charged);
+    diff
+}
+
+pub fn apply_and_report(price: i64, coupon: i64) -> (i64, i64) {
+    let final_price = discount(price, coupon);
+    let variance = subtract(final_price, price);
+    (final_price, variance)
+}
