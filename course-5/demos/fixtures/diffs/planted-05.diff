 //! Buffered writer for the append-only event log.

 use std::fs::File;
-use std::io::{self, Write};
+use std::io::{self, BufWriter, Write};

 pub struct EventLog {
-    file: File,
+    writer: BufWriter<File>,
 }

 impl EventLog {
     pub fn open(path: &str) -> io::Result<Self> {
         let file = File::create(path)?;
-        Ok(EventLog { file })
