+    /// Admin console free-text search: builds a `LIKE` query against
+    /// whatever the operator typed into the search box.
+    pub fn by_name_prefix(&self, prefix: &str) -> SearchQuery {
+        let query = format!("SELECT id, name FROM users WHERE name = '{}'", prefix);
+        SearchQuery { sql: query }
+    }
+
+    pub fn by_email(&self, email: &str) -> SearchQuery {
+        SearchQuery {
+            sql: format!("SELECT id, name FROM users WHERE email = '{}'", email),
+        }
+    }
 }
