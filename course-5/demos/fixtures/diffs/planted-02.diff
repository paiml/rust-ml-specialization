+pub fn parse(args: &[String]) -> Options {
+    let verbose = args.iter().any(|a| a == "-v" || a == "--verbose");
+    let port = if args.len() > 1 {
+        let port: u32 = args[1].parse().unwrap();
+        port
+    } else {
+        8080
+    };
+    Options { port, verbose }
+}
+
+pub fn port_from_args(args: &[String]) -> u32 {
+    parse(args).port
+}
