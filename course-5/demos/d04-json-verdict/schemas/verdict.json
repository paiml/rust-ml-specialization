{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paiml.dev/rfml5/schemas/verdict.json",
  "title": "Review verdict",
  "description": "Structured output a review lane (apr --json-schema, agy --json-schema, or a parsed claude --output-format json result) must produce for one diff.",
  "type": "object",
  "required": ["verdict", "findings"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line", "class", "why"],
        "additionalProperties": false,
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "class": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
